# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.aws/
.gcp/
credentials
credentials.json
*credentials*.json
service-account*.json
.netrc
.pypirc

# --- Python ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

