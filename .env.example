# Copy to .env and fill in. Never commit .env.
# --- Required ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Optional: search ---
# If set, Tavily is used; if empty/absent, DuckDuckGo (ddgs, no key) is used.
TAVILY_API_KEY=

# --- Models (verify current IDs at https://docs.claude.com/en/docs/about-claude/models) ---
LLM_MODEL_FAST=claude-haiku-4-5
LLM_MODEL_SMART=claude-opus-5
LLM_SMART_EFFORT=medium

# --- Limits (sensible defaults; override as needed) ---
MAX_ITERATIONS=2
MAX_SEARCHES_PER_RUN=20
MAX_FETCHES_PER_RUN=20
MAX_TOKENS_PER_RUN=400000

# --- Service ---
LOG_LEVEL=INFO
LOG_JSON=true
