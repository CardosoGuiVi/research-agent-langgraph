# Copy to .env and fill in. Never commit .env.
# --- LLM provider: anthropic (default) or openrouter ---
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Required when LLM_PROVIDER=openrouter (get a key at https://openrouter.ai; never commit it)
# OPENROUTER_API_KEY=
# OpenRouter model id (vendor/model), must support tool calling; used for all calls.
# Low-cost suggestion (catalog prices 2026-10-05, USD per 1M in/out): $0.03 / $1.28
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Optional: a different model for the final report (defaults to OPENROUTER_MODEL); $0.21 / $0.42
# OPENROUTER_MODEL_SMART=deepseek/deepseek-v4-pro
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Optional: search ---
# If set, Tavily is used; if empty/absent, DuckDuckGo (ddgs, no key) is used.
TAVILY_API_KEY=

# --- Anthropic models (verify current IDs at https://docs.claude.com/en/docs/about-claude/models) ---
LLM_MODEL_FAST=claude-haiku-4-5
LLM_MODEL_SMART=claude-opus-5
LLM_SMART_EFFORT=medium

# --- Limits (sensible defaults; override as needed) ---
MAX_ITERATIONS=2
MAX_SEARCHES_PER_RUN=20
MAX_FETCHES_PER_RUN=20
MAX_TOKENS_PER_RUN=400000

# --- Service ---
LOG_LEVEL=INFO
LOG_JSON=true
